
# GS ICP SLAM ROS2 Wrapper - Dockerfile (CPU-only, no GPU required)
# Note: Gaussian splatting rendering will be disabled or very slow without a GPU.
# This image is useful for development, testing, and non-rendering workloads
# such as ROS2 message inspection, SLAM trajectory evaluation, or CI pipelines.

FROM osrf/ros:humble-desktop

# Prevent interactive prompts
ENV DEBIAN_FRONTEND=noninteractive
ENV LC_ALL=C.UTF-8
ENV LANG=C.UTF-8

# Tell PyTorch CUDA extensions to skip GPU kernels
ENV FORCE_CUDA=0
ENV TORCH_CUDA_ARCH_LIST=""

# Install system dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    wget \
    git \
    python3-pip \
    python3-dev \
    ros-humble-ament-cmake-python \
    software-properties-common \
    libopenblas-dev \
    build-essential \
    cmake \
    libgl1-mesa-glx \
    libglib2.0-0 \
    ninja-build \
    && rm -rf /var/lib/apt/lists/*

# Upgrade pip and install compatible setuptools
RUN python3 -m pip install --upgrade pip && \
    python3 -m pip install "setuptools<70.0.0" --force-reinstall --no-cache-dir

# Install PyTorch CPU-only build
RUN pip3 install typing_extensions && \
    pip3 install torch torchvision torchaudio --index-url https://download.pytorch.org/whl/cpu --no-cache-dir

COPY requirements.txt /tmp/requirements.txt
# Remove only torch/torchvision/torchaudio lines to avoid conflict/reinstall
RUN sed -i '/^torch==/d; /^torchvision==/d; /^torchaudio==/d' /tmp/requirements.txt && \
    pip3 install --no-cache-dir -r /tmp/requirements.txt && rm /tmp/requirements.txt

# Source ROS 2 setup
RUN echo "source /opt/ros/humble/setup.bash" >> /root/.bashrc

# Create workspace
WORKDIR /workspace
RUN mkdir -p src/gs-icp-slam-ros2

# Copy source code
COPY . /workspace/src/gs-icp-slam-ros2/

# Install gaussian splatting backend + fast_gicp
RUN pip3 install --no-build-isolation \
    --no-deps \
    gsplat \
    /workspace/src/gs-icp-slam-ros2/submodules/fast_gicp

# Build the ROS2 workspace
RUN . /opt/ros/humble/setup.sh && \
    colcon build --symlink-install --cmake-args -DCMAKE_BUILD_TYPE=Release

# Download pretrained YOLOv9 model
RUN mkdir -p /workspace/src/gs-icp-slam-ros2/pretrained && \
    wget https://github.com/ultralytics/assets/releases/download/v8.2.0/yolov9e-seg.pt -P /workspace/src/gs-icp-slam-ros2/pretrained

# Set entrypoint
COPY entrypoint.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh
ENTRYPOINT ["/entrypoint.sh"]
CMD ["bash"]
